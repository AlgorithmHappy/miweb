---
import BlogCard from "../components/BlogCard.astro";
import PaginationArrowButton from "../components/PaginationArrowButton.astro";

type SortParam = `${string},${'asc' | 'desc'}`;
interface ListBlogCardsProps {
    page: number;
    size: number;
    sort: SortParam; // Ejemplos: "date,desc", "title,asc", ""tag,desc""
    search?: {
        tag?: string;
        title?: string;
    };
}

interface BlogCardProps {
    title: string;
    date: string;
    duration: number;
    description: string;
    tags: string[];
    imageSrc: string;
    imageAlt: string;
    urlRawMarkDown: string;
    titleNextPost: string;
    titlePreviousPost: string;
    titleSlug: string;
};

interface PageInfo {
  content: BlogCardProps[];
  page: number;
  size: number;
  totalElements: number;
  totalPages: number;
};

interface BlogResponse {
  success: boolean;
  message: string;
  data: PageInfo;
  timestamp: string;
};


const { request } = Astro.props as {
    request: ListBlogCardsProps;
};

const res = await fetch(
  `http://localhost:8080/v1/blog/posts?page=${request.page}&size=${request.size}&sort=${request.sort}`
);
const response: BlogResponse = await res.json();
const data: PageInfo = response.data;
const cards: BlogCardProps[] = data.content;
const lastPage: number = data.totalPages - 1;
const nextPage = `/blog?page=${request.page + 1}&size=${request.size}&sort=${request.sort}`
const previusPage = `/blog?page=${(request.page - 1) < 0 ? 0: (request.page - 1)}&size=${request.size}&sort=${request.sort}`

---
<section class="grid-container">
    
    {
        cards.map(
            (card) => (
                <BlogCard
                    title={ card.title }
                    date={ card.date }
                    duration={ card.duration }
                    description={ card.description }
                    tags={ card.tags }
                    link={ `/blog/posts/${card.titleSlug}` }
                    imageSrc={ card.imageSrc }
                    imageAlt={ card.imageAlt }
                />
            )
        )
    }
</section>
<div class="arrow-container">
    <PaginationArrowButton id="arrow-back" customHref={ previusPage } customTitle="Página anterior">
        <span class="material-icons-round" slot="arrowIcon">arrow_back</span>
    </PaginationArrowButton>
    <PaginationArrowButton id="arrow-forward" customHref={ nextPage } customTitle="Página siguiente" lastPage={ lastPage }>
        <span class="material-icons-round" slot="arrowIcon">arrow_forward</span>
    </PaginationArrowButton>
</div>


<style>
    .grid-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: 1.75rem;
        margin-bottom: 1.75rem;
        padding: 1rem;
    }
    .arrow-container {
        display: flex;
        justify-content: space-between;
    }

    @media (min-width: 768px) {
        .grid-container {
            grid-template-columns: repeat(2, 1fr);
            padding: 0;
        }
    }
    @media (min-width: 1024px) {
        .grid-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const arrowBack = document.getElementById('arrow-back') as HTMLAnchorElement;
        const arrowForward = document.getElementById('arrow-forward') as HTMLAnchorElement;
        const url = window.location.href;
        const params = new URL(url).searchParams;
        const page = Number(params.get("page"));


        if(url.includes("page=0")){
            arrowBack.classList.add("disabled")
        } else {
            arrowBack.classList.remove("disabled")
        }

        if(Number(arrowForward.dataset.lastPage) <= page){
            arrowForward.classList.add("disabled")
        } else {
            arrowForward.classList.remove("disabled")
        }
    });
</script>