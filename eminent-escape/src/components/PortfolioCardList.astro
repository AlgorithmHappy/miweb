---
import ProyectoCard from "../components/PortfolioCard.astro";

interface Technology {
    imageSrc: string;
    imageAlt: string;
    name: string;
}
interface ProjectsProps {
    title: string;
    information: string;
    link?: string;
    imageSrc: string;
    imageAlt: string;
    technologies: Technology[];
}
const projects: ProjectsProps[] = [
    {
        title: "Desafío técnico Full Stack",
        information: `Prueba técnica en la que se desarrolló una API REST con Spring Data y MySQL para consultar cobros segmentados por oficina, agente y ejecutivo, incluyendo cálculos de
        porcentajes. El frontend se implementó con Vue y Vuetify para visualizar la información de forma clara e interactiva utilizando estados.`,
        imageSrc: "assets/cobranza.webp",
        link: "https://github.com/AlgorithmHappy/gestion_de_cobranza",
        imageAlt: "Imagen del Proyecto del Desafío Técnico Full Stack",
        technologies: [
            {
                imageSrc: "assets/springboot.svg",
                imageAlt: "Icono del framework Spring",
                name: "Spring",
            },
            {
                imageSrc: "assets/mysql.svg",
                imageAlt: "Icono de base de datos de MySQL",
                name: "MySQL",
            },
            {
                imageSrc: "assets/vue.svg",
                imageAlt: "Icono del framework Vue",
                name: "Vue",
            },
            {
                imageSrc: "assets/vuetify.svg",
                imageAlt: "Icono de los componentes de Vuetify",
                name: "Vuetify",
            },
        ],
    },
    {
        title: "Landing page para leads",
        information: `Landing page desarrollada a partir de una plantilla personalizada utilizando HTML, CSS y JavaScript. Está conectada a una API REST construida con Spring Boot, la cual
        almacena correos electrónicos en una base de datos MongoDB y envía notificaciones por WhatsApp cuando un usuario se une a la lista de espera con la tecnologia de Evolution API.",
        link: "https://www.filasparabarberias.online`,
        imageSrc: "assets/landingpage.webp",
        imageAlt: "Imagen del Proyecto Landing Page para Generación de Leads",
        technologies: [
            {
                imageSrc: "assets/springboot.svg",
                imageAlt: "Icono del framework Spring",
                name: "Spring",
            },
            {
                imageSrc: "assets/html.svg",
                imageAlt: "Icono del lenguaje de marcado HTML",
                name: "HTML",
            },
            {
                imageSrc: "assets/css.svg",
                imageAlt: "Icono del lenguaje de estilo CSS",
                name: "CSS",
            },
            {
                imageSrc: "assets/javascript.svg",
                imageAlt: "Icono del lenguaje de programacion JavaScript",
                name: "JavaScript",
            },
        ],
    },
    {
        title: "Videojuego de android y PC",
        information: `Videojuego de plataformas inspirado en Doodle Jump. Creado con Godot Engine y programado en GDScript. Utiliza gráficos de Kenney y el objetivo es llegar lo más alto
        posible saltando entre plataformas. Este proyecto me ayudó a mejorar mi lógica de programación al enfrentarme a los desafíos de crear las mecánicas del juego.`,
        link: "https://balero.itch.io/brincolin",
        imageSrc: "assets/brincolin.webp",
        imageAlt: "Brincolin un videojuego realizado con Godot Engine",
        technologies: [
            {
                imageSrc: "assets/godot.svg",
                imageAlt: "Icono del motor Godot Engine",
                name: "Godot Engine",
            },
        ],
    },
    {
        title: "Videojuego para PC",
        information: `Videojuego de asteroides para computadora Juego desarrollado en C++ con el framework multimedia SFML, en el que el objetivo es esquivar asteroides. También integré una
        base de datos SQLite para manejar datos del juego. Este proyecto me permitió mejorar tanto mi lógica de programación como mis habilidades en C++ y SQL.`,
        link: "https://balero.itch.io/asteroides",
        imageSrc: "assets/asteroides.webp",
        imageAlt: "Imagen del videojuego de asteroides",
        technologies: [
            {
                imageSrc: "assets/cplusplus.svg",
                imageAlt: "Icono del lenguaje de programación C++",
                name: "C++",
            },
            {
                imageSrc: "assets/sqlite.svg",
                imageAlt: "Icono del framework SQLite",
                name: "SQLite",
            },
            {
                imageSrc: "assets/sfml.svg",
                imageAlt: "Icono del framework SFML",
                name: "SFML",
            },
        ],
    },
    {
        title: "Videojuego para PC",
        information: `Juego desarrollado en C++ con SFML. En este proyecto controlas a un cuervo que debe regular su aleteo para evitar morir. Fue una excelente oportunidad para mejorar mi
        lógica de programación mientras trabajaba con el framework multimedia SFML y el lenguaje C++.`,
        link: "https://balero.itch.io/geek",
        imageSrc: "assets/geek.webp",
        imageAlt: "Imagen del videojuego Geek",
        technologies: [
            {
                imageSrc: "assets/cplusplus.svg",
                imageAlt: "Icono del lenguaje de programación C++",
                name: "C++",
            },
            {
                imageSrc: "assets/sfml.svg",
                imageAlt: "Icono del framework SFML",
                name: "SFML",
            },
        ],
    },
    {
        title: "Calculadora de estadistica",
        information: `Proyecto escolar donde desarrollé una calculadora para obtener la media, mediana, varianza y desviación estándar a partir de datos ingresados. Usé C++ y GLUI para la
        interfaz gráfica. Este proyecto me ayudó a aplicar las matemáticas en la programación.`,
        imageSrc: "assets/calculadoraestadistica.webp",
        imageAlt: "Imagen de la calculadora de estadística descriptiva",
        link: "https://github.com/AlgorithmHappy/MedidasDispersion",
        technologies: [
            {
                imageSrc: "assets/cplusplus.svg",
                imageAlt: "Icono del lenguaje de programación C++",
                name: "C++",
            },
            {
                imageSrc: "assets/glui.svg",
                imageAlt: "Icono de la biblioteca GLUI",
                name: "GLUI",
            },
        ],
    },
];
---
<section class="grid-container">
    {
        projects.map(
            (project) => (
                <ProyectoCard
                    class="fade-in"
                    title={ project.title }
                    information={ project.information }
                    link={ project.link }
                    imageSrc={ project.imageSrc }
                    imageAlt={ project.imageAlt }
                    technologies={ project.technologies }
                />
            )
        )
    }
</section>

<style>
    .grid-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: 1.75rem;
        margin-bottom: 1.75rem;
        padding: 1rem;
    }

    @media (min-width: 768px) {
        .grid-container {
            grid-template-columns: repeat(2, 1fr);
            padding: 0;
        }
    }
    @media (min-width: 1024px) {
        .grid-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>