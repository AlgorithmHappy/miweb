---
import MainButton from "../components/MainButton.astro"

interface Technology {
    imageSrc: string;
    imageAlt: string;
    name: string;
}
interface ProjectsProps {
    title: string;
    information: string;
    link?: string;
    imageSrc: string;
    imageAlt: string;
    technologies: Technology[];
}
const { title, information, link, imageSrc, imageAlt, technologies } = Astro.props as ProjectsProps;
---
<article>
    <div>
        <h2 class="card-title">{ title }</h3>
    </div>
    <div>
        <figure class="figure-container">
            <img src={ imageSrc } alt={ imageAlt } />
            <div class="overlay">
                <p class="text">{ information }<br/><br/>
                    <MainButton class="text-link" hrefCustom={ link } materialIcon="link" text="Link" />
            </div>            
        </figure>
    </div>
    <div class="icons-container">
        {
            technologies.map( (technology: Technology) => {
                return (
                    <div class="icons-container-inner">
                        <img class="icons-images" src={ technology.imageSrc } alt={ technology.imageAlt } />
                        <span class="icons-texts">{ technology.name }</span>
                    </div>
                );
            } )
        }
    </div>
</article>

<style>
    .card-title {
        text-align: center;
        color: var(--white);
        font-weight: 700;
        margin-bottom: 1rem;
        margin-top: 1rem;
    }
    .figure-container {
        position: relative;
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-style: solid;
        border-color: var(--border);
        border-radius: var(--radius);
        box-shadow: 0 7px 10px rgba(0, 0, 0, 0.35), 0 0 0 1px var(--accent-dim);
        overflow: hidden;
    }
    .figure-container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--card-bg);
        transform: translateX(100%);
        transition: transform 0.4s ease;
    }
    .figure-container:hover::before {
        transform: translateX(0);
    }
    .figure-container img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }
    .overlay {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--card-bg);
        opacity: 0;
        transition: opacity 0.4s ease;
    }
    .overlay:hover {
        opacity: 1;
    }    
    .text {
        text-align: center;
        color: var(--muted);
    }
    .text-link {
        font-weight: 700;
        cursor: pointer;
        text-decoration: underline;
    }
    .icons-container {
        display: flex;
        flex-direction: row;
        justify-content: space-evenly;
        align-items: center;
        margin-top: 1rem;
    }
    .icons-container-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .icons-images {
        width: 1.5rem;
        height: 1.5rem;
        filter: brightness(0) saturate(100%) invert(1);
        opacity: 0.35;
    }
    .icons-texts {
        text-align: center;
        font-size: 0.75rem;
        color: var(--accent)
    }

    @media (max-width: 1024px){
        .text {
            text-align: center;
            color: var(--muted);
            font-size: xx-small;
        }
    }
    @media (max-width: 1400px){
        .text {
            text-align: center;
            color: var(--muted);
            font-size: x-small;
        }
    }
</style>