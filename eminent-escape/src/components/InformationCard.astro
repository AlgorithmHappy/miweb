---
const {icon, infoLabel, infoValue} = Astro.props;
---
<div class="info-card fade-in">
    <span class="material-icons-round">{ icon }</span>
    <div class="info-label">{ infoLabel }</div>
    <div class="info-value">{ infoValue }</div>
</div>

<style>
    .info-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px 24px;
        transition: all var(--transition);
        /*max-width: 200px;*/
    }
    .info-card:hover {
        border-color: rgba(64,224,208,0.3);
        transform: translateY(-3px);
        box-shadow: var(--shadow-card);
    }
    .info-card .material-icons-round {
        color: var(--accent);
        font-size: 20px;
        margin-bottom: 12px;
    }
    .info-label {
        font-size: 12px;
        color: var(--muted2);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        font-family: 'JetBrains Mono', monospace;
    }
    .info-value {
        font-size: 16px;
        font-weight: 600;
        color: var(--white);
    }
</style>