---
import Knowlaedge from './Knowlaedge.astro';

import type { KnowledgeProps } from './Knowlaedge.astro'

const knowledges: KnowledgeProps[] = [
    {
        image: '/assets/java.svg',
        imageTitle: 'Logo del lenguaje de programación Java',
        knowledgeTitle: 'Programación en Java',
        description: `Cuento con 5 años de experiencia desarrollando software con Java, siendo este el lenguaje de programacion que mejor domino hasta el día de hoy. Tambien, tengo
        sólidos conocimientos en programación orientada a objetos en Java, incluyendo los principios de encapsulación, herencia y polimorfismo. Me mantengo actualizado en el lenguaje,
        utilizando características modernas como Records y Optional, así como la API de Streams para el procesamiento declarativo y eficiente de datos en colecciones.`
    },
    {
        image: '/assets/springboot.svg',
        imageTitle: 'Logo del framework SpringBoot',
        knowledgeTitle: 'Desarrollo con framework Spring',
        description: `Cuento con más de 4 años de experiencia trabajando con Spring Boot, siendo el framework en el que tengo mayor dominio. Manejo ampliamente la inyección de
        dependencias, así como Spring Data y su submódulo JPA. Tengo experiencia en la creación de APIs REST con Spring Web y conocimientos básicos en Spring Batch, Spring Security y
        Spring Cloud, este último aplicado en el desarrollo de arquitecturas de microservicios.`
    },
    {
        image: '/assets/plsql.svg',
        imageTitle: 'Logo de base de datos relacionales',
        knowledgeTitle: 'Dominio de Bases de Datos SQL',
        description: `Cuento con sólidos conocimientos en bases de datos relacionales como MySQL, PostgreSQL, Oracle y SQL Server. Tengo experiencia en la creación y optimización de
        consultas para la obtención eficiente de datos, así como en el diseño de tablas con índices adecuados. Manejo programación en PL/SQL para implementar lógica de negocio en la base de datos,
        incluyendo la creación de triggers, jobs y procedimientos almacenados.`
    },
    {
        image: '/assets/kotlin.svg',
        imageTitle: 'Lenguaje de programación Kotlin',
        knowledgeTitle: 'Manejo del lenguaje Kotlin',
        description: `Kotlin es actualmente mi segundo lenguaje de programación y me encuentro en constante aprendizaje. Ya domino características clave como la programación reactiva y
        el uso de Jetpack Compose para el desarrollo de aplicaciones móviles modernas. Además, he utilizado Kotlin con Spring como alternativa a Java en el desarrollo backend,
        aprovechando su sintaxis concisa y mejoras en productividad.`
    },
    {
        image: '/assets/mongodb.svg',
        imageTitle: 'Logo de base de datos MongoDB',
        knowledgeTitle: 'Manejo de Bases de datos MongoDB',
        description: `Cuento con experiencia en bases de datos no relacionales, especialmente en MongoDB. Tengo habilidad para elaborar consultas complejas orientadas a la obtención
        eficiente de datos y manejo de grandes volúmenes de información. Utilizo herramientas como Compass para la administración y análisis de datos, así como en la creación y diseño
        de colecciones optimizadas para distintos casos de uso.`
    },
    {
        image: '/assets/javascript.svg',
        imageTitle: 'Logo del lenguaje de programación JavaScript',
        knowledgeTitle: 'Programación en JavaScript',
        description: `Cuento con conocimientos en JavaScript y experiencia desarrollando proyectos con Astro. He creado componentes interactivos utilizando TypeScript y el ecosistema de
        Astro. Además, tengo familiaridad con el framework Vue y manejo el consumo de servicios REST mediante Fetch. Actualmente, busco ampliar mis habilidades aprendiendo frameworks
        como Angular y React para fortalecer mi perfil en desarrollo frontend.`
    },
    {
        image: '/assets/git.svg',
        imageTitle: 'Logo de Git',
        knowledgeTitle: 'Trabajo en equipo con Git',
        description: `Cuento con experiencia colaborando en equipos de desarrollo, participando en la corrección de errores y mejora continua de proyectos con git. Manejo Git como
        sistema de control de versiones, realizando operaciones como merge de ramas, push a repositorios y sincronización de código mediante pull y fetch. Estoy familiarizado con flujos
        de trabajo colaborativos que facilitan la integración de cambios y el trabajo eficiente con otros desarrolladores.`
    },
    {
        image: '/assets/docker.svg',
        imageTitle: 'Logo de Docker',
        knowledgeTitle: 'Manipulacion de contenedores Docker',
        description: `Cuento con conocimientos en contenedorización utilizando Docker, herramienta que empleo para configurar y ejecutar mis proyectos en entornos locales. Tengo
        experiencia con Docker Compose para orquestar servicios mediante archivos YAML, facilitando el despliegue de entornos de desarrollo completos. Además, he trabajado en la creación
        y publicación de imágenes en Docker Hub, optimizando la portabilidad y consistencia de las aplicaciones.`
    },
    {
        image: '/assets/cplusplus.svg',
        imageTitle: 'Logo del lenguaje de programación C++',
        knowledgeTitle: 'Programación en C++',
        description: `Durante mi formación académica desarrollé habilidades en C++, lenguaje con el que fortalecí mi lógica de programación bajo el paradigma estructurado. Consolidé
        estos conocimientos mediante diversos proyectos, incluyendo el desarrollo de videojuegos con SFML. C++ me permitió comprender algoritmos fundamentales y construir bases sólidas
        para la resolución de problemas técnicos. Destaco este lenguaje por el alto nivel de control que ofrece sobre los recursos del sistema.`
    }
]

const {class: className} = Astro.props;
---
<article class={ `${className}` }>
    {
        knowledges.map(
            (item) => (
                <Knowlaedge
                    image={ item.image }
                    imageTitle={ item.imageTitle }
                    knowledgeTitle={ item.knowledgeTitle }
                    description={ item.description }
                />
            )
        )
    }
</article>