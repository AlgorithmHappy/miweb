---
const {class: className, id, lastPage, customHref, customTitle} = Astro.props;
---
<a data-last-page={ lastPage } id={ id } class={ `${className} fab` } href={ customHref } title={ customTitle }>
    <slot name="arrowIcon"></slot>
</a>

<style>
    .fab {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--accent);
        color: #1a1a1a;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 24px rgba(64,224,208,0.4);
        transition: all var(--transition);
        font-size: 24px;
        text-decoration: none;
    }
    .fab:hover {
        transform: scale(1.1) translateY(-3px);
        box-shadow: 0 10px 32px rgba(64,224,208,0.5);
    }
    .disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
        filter: grayscale(50%);
    }
</style>