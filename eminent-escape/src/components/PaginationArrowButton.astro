---
const {class: className, customHref, customTitle} = Astro.props;
---
<a class={ `${className} fab` } href={ customHref } title={ customTitle }>
    <slot name="arrowIcon"></slot>
    <!--<span class="material-icons-round">mail</span> -->
</a>

<style>
    .fab {
        /*position: fixed;
        bottom: 32px; right: 32px;
        z-index: 200;*/
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--accent);
        color: #1a1a1a;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 24px rgba(64,224,208,0.4);
        transition: all var(--transition);
        font-size: 24px;
        text-decoration: none;
    }
    .fab:hover {
        transform: scale(1.1) translateY(-3px);
        box-shadow: 0 10px 32px rgba(64,224,208,0.5);
    }
</style>