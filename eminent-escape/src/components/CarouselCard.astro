---
export interface InformationIcons {
    srcImage: string;
    altImage: string;
    description: string;
}
export interface Props {
  srcImage: string;
  altImage: string;
  title: string;
  description: string;
  experience: string;
  technologyIcons: InformationIcons[];
}

const {
    srcImage,
    altImage,
    title,
    description,
    experience,
    technologyIcons
} = Astro.props as Props;
---
<article class="carousel-card">
    <div class="card-image-wrapper">
        <img
            src = { srcImage }
            alt = { altImage }
            class="card-image"
            loading="lazy"
            decoding="async"
        />
    </div>
    <div class="card-body">
        <h3 class="card-title">{ title }</h3>
        <span class="card-experience">{ experience }</span>
        <p class="card-description">{ description }</p>
    </div>
    <div class="tech-icons-container">
        {
            technologyIcons?.map(
                (tech) => (
                    <div class="icon-container">
                        <img src={ tech.srcImage } alt={ tech.altImage } class="icon" />
                        <span>{ tech.description }</span>
                    </div>
                )
            )
        }
    </div>
</article>

<style>
    .carousel-card {
        flex: 0 0 100%;
        background: var(--card-bg);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        overflow: hidden;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease,
            border-color 0.3s ease;
        margin-right: 3rem;
        scroll-snap-align: center;
    }

    .carousel-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 7px 10px rgba(0, 0, 0, 0.35), 0 0 0 1px var(--accent-dim);
        border-color: rgba(64, 224, 208, 0.25);
    }
    .card-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 8;
        overflow: hidden;
        background: var(--white);
    }
    .card-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.5s ease;
    }
    .carousel-card:hover .card-image {
        transform: scale(1.04);
    }
    .card-body {
        padding: 1.1rem 1.25rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .card-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--white);
        margin: 0;
        line-height: 1.3;
        letter-spacing: -0.01em;
    }
    .card-experience {
        font-size: 1rem;
        font-weight: 700;
        color: var(--accent);
        margin: 0;
        line-height: 1.3;
        letter-spacing: -0.01em;
    }
    .card-description {
        font-size: 16px;
        color: var(--muted);
        margin: 0;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }    
    .tech-icons-container {
        display: flex;
        flex-wrap: nowrap;
        justify-content: space-between;
    }    
    .icon-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        font-size: 0.75rem;
        margin: 1rem 1rem 1rem 1rem;
        color: var(--accent)
    }
    .icon {
        width: 2rem;        
        filter: brightness(0) saturate(100%) invert(1);
        opacity: 0.35
    }
    span {
        white-space: pre-wrap;
    }

    @media (max-width: 640px) {
        .icon-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            font-size: 0.75rem;
            margin: 0.3rem 0.3rem 0.3rem 0.3rem;
            color: var(--accent)
        }
        .icon {
            width: 1.5rem;
            filter: brightness(0) saturate(100%) invert(1);
            opacity: 0.35
        }
    }
</style>