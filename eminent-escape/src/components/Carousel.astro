const {class: className} = Astro.props;
---
<div class={ `${className} carousel-stage` }>
    <div id="scrollContainerDesktop" class="carousel-track-outer">
        {
            cards.map(
                (item, index) => (
                    <CarouselCard
                    srcImage={ item.srcImage }
                    altImage={ item.altImage }
                    title={ item.title }
                    description={ item.description }
                    experience={ item.experience }
                    technologyIcons={ item.technologyIcons }
                    />
                )
            )
        }
    </div>

    <!-- Boton anterior -->
    <button
        class="carousel-btn carousel-btn--prev"
        id="btn-prev"
        aria-label="Anterior"
        type="button"
    >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M12.5 15l-5-5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
    <!-- Boton siguiente -->
    <button
        class="carousel-btn carousel-btn--next"
        id="btn-next"
        aria-label="Siguiente"
        type="button"
    >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
</div>

<style>
    .carousel-stage {
        position: relative;
        width: 100%;
    }
    .carousel-track-outer {
        overflow-x: auto;
        border-radius: var(--radius-card);
        padding: 0.75rem 0.75rem 0.75rem;
        display: flex;
        width: 100%;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE y Edge */
        scroll-snap-type: x mandatory;
    }
    .carousel-track-outer::-webkit-scrollbar {
        display: none; /* Chrome, Safari y Opera */
    }
    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: var(--btn-size);
        height: var(--btn-size);
        border-radius: var(--radius-btn);
        border: 1px solid rgba(64, 224, 208, 0.3);
        background: var(--bg2);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease,
            opacity 0.2s ease,
            box-shadow 0.2s ease;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    }
    .carousel-btn:hover {
        background: var(--accent);
        color: var(--bg);
        border-color: var(--accent);
        box-shadow: 0 0 20px rgba(64, 224, 208, 0.35);
    }
    .carousel-btn:active {
        transform: translateY(-50%) scale(0.93);
    }
    .carousel-btn:disabled {
        opacity: 0.3;
        pointer-events: none;
    }
    .carousel-btn--prev {
        left: -1.1rem;
    }
    .carousel-btn--next {
        right: -1.1rem;
    }

    @media (max-width: 480px) {
        .carousel-btn--prev { left: -0.6rem; }
        .carousel-btn--next { right: -0.6rem; }
    }
</style>

<script>
    let currentIndex = 0;
    const container = document.getElementById('scrollContainerDesktop') as HTMLDivElement;
    const btnLeft = document.querySelector('#btn-prev') as HTMLButtonElement;
    const btnRight = document.querySelector('#btn-next') as HTMLButtonElement;
    btnLeft.addEventListener('click', () => scrollToSlide(-1));
    btnRight.addEventListener('click', () => scrollToSlide(1));

    function scrollToSlide(direction: number) {
        // ✅ Convertir 3rem a px
        const rootFontSize = parseFloat(
            getComputedStyle(document.documentElement).fontSize
        );
        const extraOffset = (3 * rootFontSize)/2; // 3rem en px (que es el margin drecho que se pone en cada card)

        const slideWidth = container.offsetWidth + extraOffset; // 100% del contenedor
        currentIndex += direction;
        if(currentIndex < 0) {
            currentIndex = container.children.length - 1; // Vuelve al último slide
        } else if(currentIndex >= container.children.length) {
            currentIndex = 0; // Vuelve al primer slide
        }
        container.scrollTo({
            left: currentIndex * slideWidth,
            behavior: 'smooth'
        });
    }
</script>