---
import MainLayout from "../../layouts/MainLayout.astro"
import SideBar from '../../components/SideBar.astro';
import Footer from '../../components/Footer.astro';
import HeroImage from "../../components/HeroImage.astro";
import MainHeaderCenter from "../../components/MainHeaderCenter.astro";
import InfoCard from "../../components/InformationCard.astro";
import DescriptionCard from "../../components/DescriptionCard.astro";
import Carousel from "../../components/Carousel.astro";

import type { InformationIcons } from '../../components/CarouselCard.astro'
import SecondaryHeaderCenter from "../../components/SecondaryHeaderCenter.astro";
import StackKnowlaedge from "../../components/StackKnowlaedge.astro";

const icons: InformationIcons[] = [
    {
        srcImage:'/assets/java.svg',
        altImage: 'Logo del lenguaje de programación Java',
        description: 'Java'
    },
    {
        srcImage:'/assets/springboot.svg',
        altImage: 'Logo del framework Spring',
        description: 'Spring'
    },
    {
        srcImage:'/assets/mysql.svg',
        altImage: 'Logo de base de datos MySQL',
        description: 'MySQL'
    }
]
---
<MainLayout
	title="Conoce mi historia"
	description=`Desarrollador de software con más de 4 años de experiencia en Java y bases de datos SQL, enfocado en soluciones de calidad, aprendizaje continuo
    y resolución analítica de problemas, guiado por valores como la honestidad y la proactividad.`
>
    <SideBar slot="nav"/>

    <section slot="main">
        <MainHeaderCenter class="fade-in" firstText="Conoce mi" secondText="Historia"/>

        <div class="margin-image">
            <HeroImage class="fade-in" pathImage="/assets/Mi imagen de perfil.webp"/>
        </div>
        
        <div class="fade-in info-grid">
            <InfoCard icon="badge" infoLabel="Nombre" infoValue="Gerardo Márquez"/>

            <InfoCard icon="cake" infoLabel="Edad" infoValue="30 años"/>

            <InfoCard icon="school" infoLabel="Estudios" infoValue="Lic. en Informática"/>

            <InfoCard icon="work_history" infoLabel="Experiencia" infoValue="Más de 5 años"/>

            <InfoCard icon="language" infoLabel="Inglés" infoValue="B1"/>
        </div>

        <DescriptionCard class="fade-in" description=`Cuento con 5 años de experiencia profesional en el desarrollo de software utilizando Java y bases de datos relacionales con
        SQL. Me destaco no solo por mis habilidades técnicas, sino también por mis valores personales: honestidad, transparencia, nobleza, perfeccionador, pensamiento analítico y un
        enfoque proactivo para la resolución de problemas. Soy una persona comprometida con el aprendizaje continuo, apasionado por la programación y atento a las nuevas tendencias
        tecnológicas.`/>

        <SecondaryHeaderCenter class="fade-in" firstText="Mi" secondText="Experiencia"/>

        <Carousel class="fade-in"/>

        <br>
        <br>

        <SecondaryHeaderCenter class="fade-in" firstText="Mis" secondText="Conocimientos"/>

        <StackKnowlaedge class="fade-in"/>

    </section>

    <Footer slot="footer"/>
</MainLayout>

<style>
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 40px;
    }
    .text-center {
        display: block;
        text-align: center;
    }
    .margin-image {
        margin-top: 50px;
        margin-bottom: 50px;
    }
</style>