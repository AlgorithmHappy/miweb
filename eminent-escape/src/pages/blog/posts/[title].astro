---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../../layouts/PostLayout.astro";
import SideBar from "../../../components/SideBar.astro";
import Footer from "../../../components/Footer.astro";
import FloatButton from "../../../components/FloatButton.astro"
import { marked } from "marked";
import matter from "gray-matter";

type SortParam = `${string},${'asc' | 'desc'}`;
interface ListBlogCardsProps {
    page: number;
    size: number;
    sort: SortParam; // Ejemplos: "date,desc", "title,asc", ""tag,desc""
    search?: {
        tag?: string;
        title?: string;
    };
}

interface BlogCardProps {
    title: string;
    date: string;
    duration: number; // Duracion en minutos
    description: string;
    tags: string[];
    imageSrc: string;
    imageAlt: string;
    urlRawMarkDown: string;
    titleNextPost: string;
    titlePreviousPost: string;
    titleSlug: string;
};

interface PageInfo {
  content: BlogCardProps[];
  page: number;
  size: number;
  totalElements: number;
  totalPages: number;
};

interface BlogResponse {
  success: boolean;
  message: string;
  data: PageInfo;
  timestamp: string;
};

export const getStaticPaths = (
    async () => {
        const response = await fetch(`http://localhost:8080/v1/blog/posts`);
        const responseObject: BlogResponse = await response.json();
        const totalElements: number = responseObject.data.totalElements;
        const finalResponse = await fetch(`http://localhost:8080/v1/blog/posts?page=0&size=${totalElements}`);
        const finalResponseObject: BlogResponse = await finalResponse.json();
        const data: PageInfo = finalResponseObject.data;
        const post: BlogCardProps[] = data.content;

        return post.map(
            (it) => {
                return {
                    params: {
                        title: it.titleSlug
                    },
                    props: {
                        urlRawMarkDown: it.urlRawMarkDown,
                        description: it.description,
                        originTitle: it.title,
                        imageSrc: it.imageSrc,
                        titleNextPost: it.titleNextPost,
                        titlePreviousPost: it.titlePreviousPost,
                    }
                }
            }
        );
    }
) satisfies GetStaticPaths;

const { title } = Astro.params;
const { urlRawMarkDown, description, originTitle, imageSrc, titleNextPost, titlePreviousPost } = Astro.props;
const url = Astro.url.href;


const mdRes = await fetch(urlRawMarkDown);
const markdown = await mdRes.text();
const { data, content } = matter(markdown);

const html = marked.parse(content);
---

<MainLayout
    title={`Gerardo Márquez Dev - ${ originTitle }`}
    description={ description }
    image={ imageSrc }
    url={ url }
>
    <SideBar slot="nav" />

    <section slot="main" class="fade-in">
        <article class="markdown" set:html={ html } />
    </section>

    <FloatButton slot="floatButton" title={originTitle} url={url} />

    <Footer slot="footer" />
</MainLayout>

<style>
    :global(.markdown){
        font-family: "Space Grotesk", sans-serif;
        color: var(--muted);
        text-align: justify;
        font-size: 16px;
        line-height: 1.8;
    }
    :global(.markdown h1) { 
        text-align: center;
        color: var(--white);
        font-size: clamp(36px, 5vw, 64px);
        font-weight: 700;
        margin-bottom: 32px;
        display: block;
        text-align: center;
        line-height: 1;
    }
    :global(.markdown h2) { 
        text-align: center;
        color: var(--white);
        font-size: clamp(24px, 3vw, 42px);
        font-weight: 700;
        margin-bottom: 24px;
        margin-top: 24px;
        display: block;
        text-align: center;
    }
    :global(strong h2) { 
        color: var(--muted2);
    }
    :global(.markdown a) {
        color: var(--accent)
    }
    :global(.markdown ul) {
        list-style-type: disc;
        color: var(--accent)
    }
    :global(.markdown ol) {
        color: var(--accent)
    }
    /* --------------------------------------------------------------------------- */
    :global(.markdown pre) {
        background: linear-gradient(
            145deg,
            var(--bg2),
            var(--bg3)
        );
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 1.25rem 1.5rem;
        margin: 1.5rem 0;
        overflow-x: auto;
        box-shadow: var(--shadow-card);
        position: relative;
        /* scroll bonito */
        scrollbar-width: thin;
        scrollbar-color: var(--muted2) transparent;
    }
    
    /* Scrollbar para Webkit */
    :global(.markdown pre::-webkit-scrollbar) {
        height: 8px;
    }
    :global(.markdown pre::-webkit-scrollbar-thumb) {
        background: var(--accent2);
        border-radius: 999px;
    }
    :global(.markdown pre::-webkit-scrollbar-track) {
        background: transparent;
    }
    
    /* Código interno */
    :global(.markdown pre code) {
        font-family: "Fira Code", "JetBrains Mono", monospace;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--white);
        display: block;
        min-width: max-content;
    }

    /* Variante específica SQL (opcional extra cool) */
    :global(.markdown code.language-sql) {
        color: #e6e6e6;
    }

    /* Efecto hover */
    :global(.markdown pre:hover) {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent-dim), var(--shadow-card);
        transition: var(--transition);
    }

    /* Responsive */
    @media (max-width: 768px) {
        :global(.markdown pre) {
            padding: 1rem;
            font-size: 0.85rem;
        }
    }
</style>