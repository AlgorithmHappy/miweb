---
import MainLayout from "../../layouts/MainLayout.astro";
import MainHeaderCenter from "../../components/MainHeaderCenter.astro";
import PortfolioCardList from "../../components/PortfolioCardList.astro"
import MainSvgButton from "../../components/MainSvgButton.astro"
import SideBar from "../../components/SideBar.astro";
import Footer from "../../components/Footer.astro";
import GitHubSvg from "./public/assets/github.svg";
---

<MainLayout
    title="Gerardo Márquez Dev - Portafolio"
    description=`Bienvenido a mi portafolio personal. En esta sección encontrarás una selección de proyectos en los que he trabajado, tanto personales como profesionales. Cada uno refleja
    mi enfoque para resolver problemas reales, aplicar buenas prácticas y aprender continuamente nuevas tecnologías. Más allá del resultado final, estos proyectos representan mi forma de
    pensar, diseñar y construir soluciones funcionales, escalables y bien estructuradas.`
>
    <SideBar slot="nav" />

    <section slot="main">
        <MainHeaderCenter class="fade-in" firstText="Mi" secondText="Portafolio"/>
        
        <PortfolioCardList/>

        <br>
        <br>
        
        <hr class="fade-in divider" />

        <div class="fade-in" >
            <p class="description">
                Además, esta página fue desarrollada utilizando Astro, CSS
                y TypeScript. En la sección de contacto, se integra un sistema de
                envío de notificaciones por WhatsApp mediante Java, Spring y
                Evolution API. Si deseas conocer más de mis proyectos, puedes
                visitar mi perfil de GitHub haciendo clic en el botón de abajo.
            </p>
            <div class="elements">
                <MainSvgButton hrefCustom="https://github.com/AlgorithmHappy" icon={ GitHubSvg } text="Ver más en GitHub"/>
            </div>
        </div>    

        <hr class="fade-in divider" />

    </section>

    <Footer slot="footer" />
</MainLayout>

<style>
    .title {
        margin-top: 5rem;
        text-align: center;
        color: var(--accent);
        font-weight: 600;
        font-size: 1.5rem;
    }
    .divider {
        border: none;
        height: 3px;
        background-color: var(--accent);
        width: 50%;
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 1rem;
        border-radius: 0.5rem;
    }
    .description {
        text-align: center;
        color: var(--muted);
    }    
    .elements {
        margin-left: auto;
        margin-right: auto;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        width: 100%;        
        display: flex;
        justify-content: center;
        align-items: center;
    }

    @media (min-width: 768px) {
        .title {
            font-size: 2.25rem;
        }
    }
    @media (min-width: 1024px) {
        .title {
            font-size: 3.75rem;
        }
    }
</style>
